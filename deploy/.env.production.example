# Copy to /opt/next_offer/.env on the server and fill in real values.
# Required by docker-compose.prod.yml (missing values abort the deploy).

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_USER=next_offer
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=next_offer

# --- RabbitMQ -------------------------------------------------------------
RABBITMQ_USER=next_offer
RABBITMQ_PASSWORD=CHANGE_ME_STRONG

# --- Public hostname ------------------------------------------------------
# Caddy serves the UI and proxies /api on this hostname with automatic TLS.
# No domain purchase needed: sslip.io resolves <anything>.<IP>.sslip.io to <IP>.
# Example: next-offer.203.0.113.10.sslip.io
API_DOMAIN=next-offer.CHANGE_ME_SERVER_IP.sslip.io

# Same-origin UI + API, so CORS is not strictly needed, but keep it aligned
# with API_DOMAIN in case you expose the API separately later.
CORS_ORIGINS=["https://next-offer.CHANGE_ME_SERVER_IP.sslip.io"]

# --- Yandex AI Studio / YandexGPT ----------------------------------------
LLM_ENABLED=true
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt
YANDEX_MODEL_VERSION=latest
YANDEX_MODEL_URI=
YANDEX_TIMEOUT_SECONDS=15
YANDEX_TEMPERATURE=0.7
YANDEX_MAX_TOKENS=220
