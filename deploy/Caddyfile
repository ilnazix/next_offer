{$API_DOMAIN} {
	encode gzip zstd

	handle /api/* {
		reverse_proxy app:8000
	}

	handle /health {
		reverse_proxy app:8000
	}

	handle /docs* {
		reverse_proxy app:8000
	}

	handle /openapi.json {
		reverse_proxy app:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format console
	}
}
