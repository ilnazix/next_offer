# --- PostgreSQL -----------------------------------------------------------
POSTGRES_USER=next_offer
POSTGRES_PASSWORD=change_me
POSTGRES_DB=next_offer
POSTGRES_PORT=5432

# --- API ------------------------------------------------------------------
APP_PORT=8000

# --- RabbitMQ -------------------------------------------------------------
RABBITMQ_USER=next_offer
RABBITMQ_PASSWORD=change_me
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# JSON list of browser origins allowed by the API (local Vite dev server by default)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Frontend (Vite dev server) -------------------------------------------
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
VITE_CLIENT_ID=1

# --- Yandex AI Studio / YandexGPT (optional) ------------------------------
# Set LLM_ENABLED=true and fill in credentials to generate offer text via LLM.
# Without it, worker uses banner_templates text.
LLM_ENABLED=false
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-lite
YANDEX_MODEL_VERSION=latest
# Full model URI override, e.g. gpt://<folder_id>/yandexgpt/latest.
# If set, it takes precedence over YANDEX_MODEL and YANDEX_MODEL_VERSION.
YANDEX_MODEL_URI=
YANDEX_TIMEOUT_SECONDS=10
YANDEX_TEMPERATURE=0.7
YANDEX_MAX_TOKENS=200
